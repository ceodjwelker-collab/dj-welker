---
import Base from '../layouts/Base.astro';
---
<Base
  title="Not found — DJ Welker"
  description="DJ Welker — creative systems designer, builder, and founder."
  robots="noindex,follow"
>
<main id="main">
<section style="min-height:66vh;display:flex;align-items:center"><div class="wrap" style="max-width:640px">
  <div class="eyebrow accent">Error 404</div>
  <h1 style="font-size:clamp(3rem,9vw,6rem);letter-spacing:-.04em;margin:12px 0 12px;line-height:.95">This page didn't make the cut.</h1>
  <p class="lead">The link's broken or the page moved. Let's get you back to the work.</p>
  <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn--accent" href="/">Home <span class="ar">→</span></a><a class="btn" href="/work">See the work</a><a class="btn" href="/logos">Logos</a><a class="btn" href="/contact">Get in touch</a></div>
  <div style="margin-top:34px;border-top:1px solid var(--line);padding-top:18px">
    <div class="eyebrow" style="margin-bottom:10px">Popular case studies</div>
    <ul style="list-style:none;font-family:var(--display);font-weight:600;line-height:2.1">
      <li><a href="/work/titanium-detailing">Titanium Detailing — live client, zero to bookable <span class="ar">↗</span></a></li>
      <li><a href="/work/ce-os">CE OS — studio + product system <span class="ar">↗</span></a></li>
      <li><a href="/work/shiftly">Shiftly — hourly-business operations OS <span class="ar">↗</span></a></li>
      <li><a href="/work/auxtion">AUXTION — pay-to-play request app <span class="ar">↗</span></a></li>
    </ul>
  </div>
</div></section>
</main>
<footer style="padding:30px 0"><div class="wrap"><div style="font-family:var(--mono);font-size:.72rem;opacity:.7">© 2026 DJ Welker · York, PA + remote</div></div></footer>

</Base>
