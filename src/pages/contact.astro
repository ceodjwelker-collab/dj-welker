---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact — DJ Welker"
  description="Get in touch with DJ Welker about a role, project, or collaboration. Email ceodjwelker@gmail.com, call (717) 881-4960, or Instagram @dj.welker."
  current="contact"
>
<main id="main">

<header class="case-head"><div class="wrap">
  <div class="k">Contact</div>
  <h1>Let's talk.</h1>
  <p class="tag">Reach out about a role, a project, or a collaboration. The fastest way to me is email or a call — no forms, no funnel.</p>
</div></header>

<section class="csec"><div class="wrap">
  <div class="abgrid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
    <div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;margin-bottom:12px;background:var(--card)"><div class="l">Email</div><div class="v" style="font-size:1.2rem;display:flex;align-items:center;gap:12px"><a href="mailto:ceodjwelker@gmail.com">ceodjwelker@gmail.com</a> <button class="proofbtn" id="copyEmail" style="border-radius:4px">Copy</button></div></div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;margin-bottom:12px;background:var(--card)"><div class="l">Phone</div><div class="v" style="font-size:1.2rem"><a href="tel:+17178814960">(717) 881-4960</a></div></div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;margin-bottom:12px;background:var(--card)"><div class="l">Instagram</div><div class="v" style="font-size:1.2rem"><a href="https://instagram.com/dj.welker" target="_blank" rel="noopener">@dj.welker</a></div></div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;margin-bottom:12px;background:var(--card)"><div class="l">LinkedIn</div><div class="v" style="font-size:1.2rem"><a href="https://www.linkedin.com/in/dj-welker" target="_blank" rel="noopener">in/dj-welker</a></div></div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;margin-bottom:12px;background:var(--card)"><div class="l">TikTok</div><div class="v" style="font-size:1.2rem"><a href="https://www.tiktok.com/@dj.welker" target="_blank" rel="noopener">@dj.welker</a></div></div>
      <div class="fact" style="border:1px solid var(--line);border-radius:4px;background:var(--card)"><div class="l">Based</div><div class="v" style="font-size:1.2rem">York, PA · Working remote</div></div>
    </div>
    <div>
      <p style="font-size:1.05rem;margin-bottom:16px">Reach out about an opportunity, a role, or a project. A quick note about what you're hiring for works great.</p>
      <a class="btn btn--accent" href="mailto:ceodjwelker@gmail.com?subject=Opportunity%20for%20DJ%20Welker" style="width:100%;justify-content:center">Start an email <span class="ar">↗</span></a>
      <div style="margin-top:16px"><a class="btn" href="/resume" style="width:100%;justify-content:center">Download / view résumé</a></div>
    </div>
  </div>
</div></section>

</main>
<footer><div class="wrap"><div style="font-family:var(--mono);font-size:.8rem;opacity:.85">© 2026 DJ Welker · ceodjwelker@gmail.com · @dj.welker · York, PA + remote</div></div></footer>

<script is:inline>
(function(){var c=document.getElementById('copyEmail');if(c)c.addEventListener('click',function(){navigator.clipboard&&navigator.clipboard.writeText('ceodjwelker@gmail.com');c.textContent='Copied';setTimeout(function(){c.textContent='Copy';},1400);});})();
</script>
</Base>
