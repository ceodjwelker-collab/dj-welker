---
import Base from '../layouts/Base.astro';
import { featured, categories } from '../data/projects';

const catLabel = Object.fromEntries(categories.map((c) => [c.f, c.label]));
const feat = featured;
---
<Base
  title="DJ Welker — Creative Systems Designer & Business Modernizer"
  description="DJ Welker builds brands, products, campaigns, and systems that make businesses harder to ignore and easier to run. York, PA + remote."
  type="profile"
  current="home"
>
<main id="main">

<!-- HERO -->
<header class="home-hero home-intro"><div class="wrap home-intro__grid">
  <div class="home-intro__copy">
    <div class="home-intro__topline"><span class="eyebrow">DJ Welker · York, PA + remote</span><span>Available for the right build</span></div>
    <h1>Make the business<br /><span>feel inevitable.</span></h1>
    <p class="home-intro__thesis">DJ Welker is a creative systems designer. He gives ambitious businesses the identity, digital experience, and operating tools to look established and run with intent.</p>
    <div class="home-hero__actions">
      <a class="btn btn--accent" href="#work">See the work <span class="ar">↓</span></a>
      <a class="btn" href="/contact">Start a conversation <span class="ar">→</span></a>
    </div>
    <div class="home-intro__roles" aria-label="Core disciplines"><span>Brand systems</span><span>Digital products</span><span>Business operations</span></div>
    <p class="proof-only home-hero__proof">◉ Proof Mode is on — role, constraints, and launched status are shown on each project.</p>
  </div>
  <div class="home-intro__art" aria-label="A selection of DJ Welker's work">
    <div class="home-intro__line"></div>
    <figure class="home-intro__canvas"><img src="/assets/shots/ce-os-live.jpg" alt="CE OS live studio website" fetchpriority="high" width="1200" height="750" /><div class="home-intro__brandmark"><img src="/assets/logos/ce-os-navbar-logo.png" alt="CE OS logo" width="384" height="182" /></div></figure>
    <a class="home-intro__case" href="/work/auxtion" aria-label="Read the AUXTION case study">
      <img src="/assets/shots/auxtion-live.jpg" alt="AUXTION product interface" width="1200" height="750" />
      <span><b>AUXTION</b><small>Live product system</small></span>
    </a>
    <div class="home-intro__monogram" aria-hidden="true"><span>DJ</span><small>01 / 26</small></div>
  </div>
</div></header>

<!-- CAPABILITY STRIP -->
<section style="background:var(--ink);color:var(--paper);border:none"><div class="wrap" style="padding:20px 28px;display:flex;gap:26px;flex-wrap:wrap;font-family:var(--mono);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--paper)">
  <span>Brand Systems</span><span style="color:var(--accent)">/</span><span>Digital Products</span><span style="color:var(--accent)">/</span><span>Campaigns</span><span style="color:var(--accent)">/</span><span>Experiences</span><span style="color:var(--accent)">/</span><span>Operations</span>
</div></section>

<!-- SELECTED WORK -->
<section class="pad" id="work"><div class="wrap">
  <div class="sec-head"><h2>Selected work</h2><span class="eyebrow">01 — 0{feat.length} · more in the archive</span></div>
  <div class="worklist">
    {feat.map((p, i) => (
      <article class="witem reveal">
        <div class="wmeta">
          <div class="num">0{i + 1} · {p.proofStatus === 'LAUNCHED' ? (p.client.includes('own') || p.slug === 'ce-os' ? 'Flagship' : 'Client / live') : 'Product'}</div>
          <h3>{p.title} {p.titleSuffix && <span style="font-family:var(--mono);font-size:.9rem;color:var(--muted)">{p.titleSuffix}</span>}</h3>
          <div class="sum">{p.summary}</div>
          <div class="tags">
            {p.categories.map((c) => <span class="tag">{catLabel[c]}</span>)}
            <span class="tag status">{p.status}</span>
          </div>
          <div class="proofpanel proof-only"><div class="pl">Proof · DJ's role</div><p>{p.proof}</p></div>
          <a class="wlink" href={`/work/${p.slug}`}>Read case study <span class="ar">↗</span></a>
          {p.liveUrl && <a class="wlink" href={p.liveUrl} target="_blank" rel="noopener">Visit live <span class="ar">↗</span></a>}
        </div>
        {p.thumb ? (
          <div class={`wshot${p.thumbContain ? ' emblem' : ''}`} style={p.thumbBg ? `background:${p.thumbBg}` : undefined}>
            <img src={p.thumb} alt={`${p.title} — ${p.role}`} loading="lazy" decoding="async" />
          </div>
        ) : (
          <div class="wshot"><div class="ph">{p.title}<br>{p.role} · {p.status}</div></div>
        )}
      </article>
    ))}
  </div>
  <div style="margin-top:34px"><a class="btn" href="/work">See the full archive <span class="ar">→</span></a></div>
</div></section>

<!-- LOGO DESIGN TEASER -->
<section class="pad"><div class="wrap">
  <div class="sec-head"><h2>Logo &amp; brand marks</h2><span class="eyebrow">Identity design</span></div>
  <div class="caps" style="grid-template-columns:1.4fr 1fr;align-items:center">
    <div>
      <p style="font-family:var(--serif);font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.35;max-width:36ch">Marks for real ventures and real clients — the AUXTION “Signal A”, Shiftly’s Punch Track, LIFTWAVE, ScrollStop, Thrown After, TSO, CE OS, and a client-approved Top Flavorz logo.</p>
      <div style="margin-top:22px"><a class="btn btn--accent" href="/logos">See the logo showcase <span class="ar">→</span></a></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div class="wshot emblem" style="aspect-ratio:1;background:#080A0F"><img src="/assets/logos/auxtion-mark.svg" alt="AUXTION Signal A mark" loading="lazy" /></div>
      <div class="wshot emblem" style="aspect-ratio:1;background:#05070b"><img src="/assets/logos/ce-os-navbar-logo.png" alt="CE OS blue-and-chrome logo" loading="lazy" /></div>
      <div class="wshot emblem" style="aspect-ratio:1;background:#090A0C"><img src="/assets/logos/liftwave-logo.svg" alt="LIFTWAVE logo" loading="lazy" /></div>
      <div class="wshot emblem" style="aspect-ratio:1;background:#050505"><img src="/assets/logos/top-flavorz-logo.png" alt="Top Flavorz logo" loading="lazy" /></div>
    </div>
  </div>
</div></section>

<!-- CAPABILITIES BY OUTCOME -->
<section class="pad"><div class="wrap">
  <div class="sec-head"><h2>What I actually do</h2><span class="eyebrow">Organized by outcome</span></div>
  <div class="caps">
    <div class="cap reveal"><div class="n">01 · Build</div><h3>Make it look established</h3><ul><li>Brand identity &amp; systems</li><li>Logo &amp; identity design</li><li>Websites, apps &amp; portals</li><li>Campaign &amp; social creative</li></ul></div>
    <div class="cap reveal"><div class="n">02 · Connect &amp; Automate</div><h3>Make the experience work</h3><ul><li>Booking &amp; conversion flows</li><li>CRM, forms, calendars, payments</li><li>Follow-up &amp; review automation</li><li>Digital products &amp; tools</li></ul></div>
    <div class="cap reveal"><div class="n">03 · Run</div><h3>Make it easier to run</h3><ul><li>Dashboards &amp; analytics</li><li>SOPs &amp; internal systems</li><li>AI-assisted workflows</li><li>Whole-business operating systems</li></ul></div>
  </div>
  <div style="margin-top:26px"><a class="btn" href="/services">See services &amp; skills <span class="ar">→</span></a></div>
</div></section>

<!-- ABOUT SNIPPET -->
<section class="pad"><div class="wrap homeabout">
  <div class="homeabout__system" aria-label="DJ Welker brand systems">
    <div class="homeabout__tile homeabout__tile--ce"><img src="/assets/logos/ce-os-navbar-logo.png" alt="CE OS logo" loading="lazy" width="384" height="182" /></div>
    <div class="homeabout__tile"><img src="/assets/logos/auxtion-mark.svg" alt="AUXTION Signal A logo" loading="lazy" /></div>
    <div class="homeabout__tile"><img src="/assets/logos/liftwave-logo.svg" alt="LIFTWAVE logo" loading="lazy" /></div>
    <div class="homeabout__tile"><img src="/assets/logos/shiftly-mark.png" alt="Shiftly Punch Track logo" loading="lazy" /></div>
  </div>
  <div>
    <span class="eyebrow">About</span>
    <p style="font-family:var(--serif);font-size:clamp(1.4rem,2.6vw,2rem);line-height:1.35;margin-top:18px">DJ Welker is a self-taught creative director, designer, and maker in York, PA — an operator, a builder, and a founder. He works across brand, product, content, and operations: the visible identity and the invisible system behind it, with direct access to the person doing the work.</p>
    <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/about">More about DJ <span class="ar">→</span></a><a class="btn btn--accent" href="/contact">Get in touch <span class="ar">→</span></a></div>
  </div>
</div></section>

<!-- WORK STRIP -->
<section class="home-workstrip"><div class="wrap"><div class="home-workstrip__head"><span class="eyebrow">Built systems, not stock signals</span><a href="/work">View the archive <span class="ar">→</span></a></div><div class="home-workstrip__grid">
  <img src="/assets/shots/titanium-live.jpg" alt="Titanium Detailing live work" loading="lazy" decoding="async" width="1200" height="750" />
  <img src="/assets/shots/shiftly-live.jpg" alt="Shiftly product interface" loading="lazy" decoding="async" width="1200" height="750" />
  <img src="/assets/shots/liftwave-live.jpg" alt="LIFTWAVE product interface" loading="lazy" decoding="async" width="1200" height="750" />
</div></div></section>

</main>
<footer><div class="wrap">
  <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px;align-items:flex-start">
    <div style="max-width:420px">
      <div style="font-family:var(--display);font-weight:700;font-size:1.8rem;letter-spacing:-.02em;margin-bottom:12px">Open to the right opportunity.</div>
      <a class="btn btn--accent" href="mailto:ceodjwelker@gmail.com">Email DJ <span class="ar">↗</span></a>
    </div>
    <div style="font-family:var(--mono);font-size:.8rem;line-height:2;opacity:.85">
      <div><a href="mailto:ceodjwelker@gmail.com">ceodjwelker@gmail.com</a></div>
      <div>York, PA · Remote</div>
      <div><a href="/resume">Résumé</a> · <a href="/work">Work</a> · <a href="/logos">Logos</a> · <a href="/contact">Contact</a></div>
      <div><a href="https://instagram.com/dj.welker" target="_blank" rel="noopener">Instagram @dj.welker</a> · <a href="https://www.linkedin.com/in/dj-welker" target="_blank" rel="noopener">LinkedIn</a> · <a href="https://www.tiktok.com/@dj.welker" target="_blank" rel="noopener">TikTok</a> · <a href="tel:+17178814960">(717) 881-4960</a></div>
    </div>
  </div>
  <div style="border-top:1px solid rgba(244,241,234,.2);margin-top:34px;padding-top:18px;font-family:var(--mono);font-size:.72rem;opacity:.6;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <span>© 2026 DJ Welker</span><span>Creative systems designer &amp; business modernizer</span>
  </div>
</div></footer>

</Base>

<style>
  .home-intro{background:var(--paper);padding:clamp(52px,7vw,102px) 0 clamp(60px,8vw,112px)}
  .home-intro__grid{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(350px,.86fr);align-items:end;gap:clamp(42px,7vw,110px)}
  .home-intro__topline{display:flex;align-items:center;gap:14px;margin-bottom:clamp(32px,5vw,66px)}
  .home-intro__topline>span:last-child{font-family:var(--mono);font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);border-left:1px solid var(--line);padding-left:14px}
  .home-intro h1{max-width:11ch;font-size:clamp(3.65rem,7.4vw,7.75rem);font-weight:600;letter-spacing:-.078em;line-height:.84}
  .home-intro h1 span{color:var(--accent)}
  .home-intro__thesis{max-width:51ch;margin-top:30px;font-size:clamp(1.14rem,1.7vw,1.42rem);line-height:1.52;color:var(--ink2)}
  .home-intro__roles{display:flex;gap:0;flex-wrap:wrap;margin-top:42px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .home-intro__roles span{padding:12px 17px 12px 0;margin-right:17px;border-right:1px solid var(--line);font-family:var(--mono);font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
  .home-intro__roles span:last-child{border-right:0}
  .home-intro__art{position:relative;min-height:min(57vw,650px);padding:24px 0 0 24px}
  .home-intro__line{position:absolute;inset:0 9% auto 0;height:1px;background:var(--ink)}
  .home-intro__canvas{position:absolute;top:24px;right:9%;bottom:0;left:13%;overflow:hidden;background:#090c10}
  .home-intro__canvas>img{width:100%;height:100%;object-fit:cover;object-position:top;opacity:.72}
  .home-intro__canvas::after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,rgba(5,9,17,.08),rgba(5,8,13,.72))}
  .home-intro__brandmark{position:absolute;z-index:1;top:50%;left:50%;width:min(76%,380px);transform:translate(-50%,-50%);padding:16px;background:rgba(5,8,13,.56);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(8px)}
  .home-intro__brandmark img{width:100%;height:auto}
  .home-intro__case{position:absolute;z-index:2;left:0;bottom:5%;display:block;width:min(56%,260px);background:var(--card);border:1px solid var(--ink);box-shadow:9px 9px 0 var(--accent)}
  .home-intro__case img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;object-position:top}
  .home-intro__case span{display:flex;justify-content:space-between;gap:10px;padding:10px 12px;font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}
  .home-intro__case small{font:inherit;color:var(--muted)}
  .home-intro__monogram{position:absolute;right:0;bottom:11%;z-index:3;display:grid;gap:6px;padding:13px 15px;background:var(--accent);color:var(--paper)}
  .home-intro__monogram span{font-family:var(--display);font-size:2.5rem;font-weight:700;line-height:.8;letter-spacing:-.1em}
  .home-intro__monogram small{font-family:var(--mono);font-size:.55rem;letter-spacing:.08em}
  .homeabout__system{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-self:stretch;background:#07090d;padding:8px;border:1px solid var(--line);border-radius:6px}
  .homeabout__tile{display:flex;align-items:center;justify-content:center;min-height:170px;padding:24px;background:#0d1014}
  .homeabout__tile--ce{grid-column:1 / -1;background:#080b10}
  .homeabout__tile img{max-width:78%;max-height:108px;object-fit:contain}
  .homeabout__tile--ce img{max-width:84%;max-height:116px}
  .home-workstrip{padding:0 0 72px;background:var(--ink);border:none;color:var(--paper)}
  .home-workstrip__head{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px 0 16px}.home-workstrip__head .eyebrow{color:rgba(244,240,230,.62)}.home-workstrip__head a{font-family:var(--display);font-weight:600;border-bottom:2px solid var(--accent);padding-bottom:2px}
  .home-workstrip__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}.home-workstrip__grid img{width:100%;height:clamp(190px,25vw,340px);object-fit:cover;object-position:top;display:block}
  @media(max-width:900px){.home-intro__grid{grid-template-columns:1fr;align-items:start}.home-intro__art{max-width:620px;min-height:560px;margin-left:auto;width:100%}.home-intro h1{max-width:10.5ch}}
  @media(max-width:560px){.home-intro{padding-top:46px}.home-intro__topline{align-items:flex-start;flex-direction:column;gap:9px;margin-bottom:38px}.home-intro__topline>span:last-child{border-left:0;padding-left:0}.home-intro h1{font-size:clamp(3.3rem,15.5vw,4.8rem)}.home-intro__roles{margin-top:34px}.home-intro__roles span{width:100%;margin:0;padding:11px 0;border-right:0;border-bottom:1px solid var(--line)}.home-intro__roles span:last-child{border-bottom:0}.home-intro__art{min-height:430px;padding-left:16px}.home-intro__canvas{left:9%;right:4%}.home-intro__case{width:57%;box-shadow:6px 6px 0 var(--accent)}.home-intro__case span{display:block;line-height:1.6}.home-intro__case small{display:block}.home-intro__monogram{right:0;bottom:9%;padding:10px 12px}.home-intro__monogram span{font-size:2rem}.homeabout__tile{min-height:125px;padding:16px}.home-workstrip{padding-bottom:44px}.home-workstrip__grid{grid-template-columns:1fr}.home-workstrip__grid img{height:220px}}
</style>
